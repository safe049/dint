# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ---- LLM provider (OpenAI-compatible) -------------------------------------
# Works with OpenAI, OpenRouter, Groq, Together, or a local Ollama server
# (for Ollama use OPENAI_BASE_URL=http://localhost:11434/v1).
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1

# Model dint uses for teaching. MUST support tool / function calling.
DINT_MODEL=gpt-4o-mini

# Optional cheaper model for the background "reflection" pass that updates
# the skill graph, knowledge graph and long-term memory. Defaults to DINT_MODEL.
REFLECT_MODEL=

# ---- Storage --------------------------------------------------------------
# SQLite database file, relative to the project root.
DATABASE_URL=dint.db

# ---- Behaviour ------------------------------------------------------------
# Maximum number of tool-call rounds dint may take in a single turn.
MAX_TOOL_ROUNDS=8

# Number of results fetched per web search.
WEB_SEARCH_RESULTS=5